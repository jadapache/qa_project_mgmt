# QA Project Mgmt Environment Variables

# App Config
PROJECT_NAME="QA Project Mgmt"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Auth
SECRET_KEY="change-this-secret-key-to-a-secure-random-string-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480 # 8 hours

# Database
DATABASE_URL="postgresql+asyncpg://qa_mgmt_user:qa_mgmt_password@localhost:5432/qa_mgmt_db"
SYNC_DATABASE_URL="postgresql://qa_mgmt_user:qa_mgmt_password@localhost:5432/qa_mgmt_db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# CORS
ALLOWED_ORIGINS=["http://localhost:5173", "tauri://localhost", "https://tauri.localhost"]

# Jira Integration Encryption Key (32 url-safe base64-encoded bytes)
JIRA_ENCRYPTION_KEY="make_a_fernet_key_here_32_bytes_base64_encoded="

# RAG & AI Motor Config
LLM_PROVIDER="openai" # openai / ollama / gemini
OPENAI_API_KEY="sk-..."
EMBEDDING_MODEL="text-embedding-3-small"
RAG_SIMILARITY_THRESHOLD=0.75
